# --- Development Dockerfile for FastAPI ---
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY ./api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy code
COPY ./api /app

# Expose API port
EXPOSE 8000

# Enable live reload
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
